# PARTYVERSE — public client configuration (copy to .env, never commit .env).
# Values come from Supabase › Project Settings › API.
# The anon key is public by design: every table is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side secrets (service role key, SMTP, …) are NOT used by the app.
# They live in Supabase (Edge Function secrets / dashboard), never here.
