# PARTYVERSE — public client configuration (copy to .env, never commit .env).
# Values come from Supabase › Project Settings › API.
# The anon key is public by design: every table is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Expo push tokens need the EAS project id (`eas init`). Leave empty to disable push:
# the app then says so in Settings instead of pretending.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Server-side secrets are NOT used by the app and never belong in this file.
# They live in Supabase (Edge Function secrets / Vault), see docs/setup.md:
#   SUPABASE_SERVICE_ROLE_KEY   provided automatically to Edge Functions
#   PUSH_DISPATCH_SECRET        shared by the scheduler and push-dispatch
#   EXPO_ACCESS_TOKEN           optional, Expo "enhanced push security"
